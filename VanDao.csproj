<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <!-- Cửa sổ desktop (WinForms + WebView2) nên cần target Windows -->
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <OutputType>WinExe</OutputType>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>VanDao</RootNamespace>
    <AssemblyName>NguoiLuoiTuTien</AssemblyName>
    <Title>Người Lười Tu Tiên</Title>
    <Product>Người Lười Tu Tiên</Product>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <ApplicationIcon>wwwroot\img\app\icon.ico</ApplicationIcon>
    <!-- Bản build kiểm tra, bản phát hành và tài liệu không phải đầu vào của game. -->
    <DefaultItemExcludes>$(DefaultItemExcludes);build-check\**;publish\**;docs\**;Claude outputs\**;test\**</DefaultItemExcludes>
    <!-- Phiên bản lấy TỰ ĐỘNG từ git tag gần nhất (vX.Y.Z) lúc build, xem target VersionFromGitTag bên dưới.
         Số dưới đây chỉ dùng khi không có git / chưa có tag. Ép số khác: dotnet publish -p:VersionFromTag=false -p:Version=1.2.3 -->
    <Version>0.7.4</Version>
  </PropertyGroup>

  <!-- Version = tag vX.Y.Z gần nhất trên nhánh hiện tại (git describe). Không có git / không có tag thì giữ số ở trên. -->
  <Target Name="VersionFromGitTag" BeforeTargets="GetAssemblyVersion;GenerateAssemblyInfo;CoreCompile" Condition="'$(VersionFromTag)' != 'false'">
    <Exec Command="git describe --tags --abbrev=0 --match &quot;v[0-9]*&quot;" ConsoleToMSBuild="true" IgnoreExitCode="true" StandardOutputImportance="low" StandardErrorImportance="low" WorkingDirectory="$(MSBuildProjectDirectory)">
      <Output TaskParameter="ConsoleOutput" PropertyName="_GitTag" />
      <Output TaskParameter="ExitCode" PropertyName="_GitTagExit" />
    </Exec>
    <PropertyGroup Condition="'$(_GitTagExit)' == '0' And $([System.Text.RegularExpressions.Regex]::IsMatch('$(_GitTag)', '^v\d+\.\d+\.\d+$'))">
      <Version>$(_GitTag.Substring(1))</Version>
      <VersionPrefix>$(Version)</VersionPrefix>
      <AssemblyVersion>$(Version).0</AssemblyVersion>
      <FileVersion>$(Version).0</FileVersion>
      <InformationalVersion>$(Version)</InformationalVersion>
    </PropertyGroup>
    <Message Importance="high" Text="Phiên bản game: $(Version)" />
  </Target>


  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="8.0.11" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.2903.40" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="wwwroot\img\app\icon.ico" LogicalName="VanDao.AppIcon.ico" />
    <Content Update="wwwroot\**" CopyToOutputDirectory="PreserveNewest" />
    <!-- công cụ mô phỏng cân bằng (project riêng): không biên dịch vào game -->
    <Compile Remove="tools\**" />
    <Content Remove="tools\**" />
    <None Remove="tools\**" />
    <!-- launcher: project riêng, không biên dịch vào game -->
    <Compile Remove="NguoiLuoiTuTienLauncher\**;VanDaoLauncher\**" />
    <Content Remove="NguoiLuoiTuTienLauncher\**;VanDaoLauncher\**" />
    <None Remove="NguoiLuoiTuTienLauncher\**;VanDaoLauncher\**" />
    <!-- Local Launcher settings may contain credentials from older versions. -->
    <Content Remove="**\launcher_settings.json" />
    <None Remove="**\launcher_settings.json" />
  </ItemGroup>

</Project>
