# Chép thành .env trong thư mục server (mặc định %USERPROFILE%\vandao-server) rồi điền giá trị thật.
# Giống các biến đang nhập trên dashboard Render (tools/online_cloud/README.md mục 4).

# Token của Cloudflare Tunnel (Zero Trust → Networks → Tunnels → tunnel của bạn → Docker → chuỗi sau --token)
TUNNEL_TOKEN=

Online__AuthUrl=https://kjbzahndcgwgxqqkzvym.supabase.co
Online__PublishableKey=
# Tên miền public của tunnel, vd https://online.example.com
Online__PublicUrl=https://online.example.com
# Tuỳ chọn: UID Supabase được dùng admin mode, cách nhau bởi dấu phẩy
Online__AdminUsers=

# Role game_backend qua session pooler, giống Render:
# ...;SSL Mode=VerifyFull;Root Certificate=/etc/secrets/supabase-ca.crt
ConnectionStrings__Game=
